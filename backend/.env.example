# ─────────────────────────────────────────────────────────────────────────────
# AI Conversation Simulator — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Groq API Key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supabase — use the SERVICE ROLE key (backend only, never exposed to frontend)
# https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# CORS — comma-separated list of allowed frontend origins
# For local dev: http://localhost:3000
# For production: https://your-vercel-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
